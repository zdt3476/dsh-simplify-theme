{
  "name": "dsh-simplify-theme",
  "version": "0.3.9",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "给 DeepSeek Harness 的极简主题，附带侧栏分页与筛选、输入框下方模型/权限控件、子代理委派图等界面增强。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zdt3476/dsh-simplify-theme.git"
  },
  "homepage": "https://github.com/zdt3476/dsh-simplify-theme#readme",
  "bugs": {
    "url": "https://github.com/zdt3476/dsh-simplify-theme/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "icon.png",
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "docs/images/*.png",
    "icon.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "test": "pnpm run typecheck && vitest run",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "license": "MIT",
  "author": "zdt3476 <zdt3476@gmail.com>",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "theme",
    "minimal"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
